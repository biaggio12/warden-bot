# Copy to .env and adjust. Every value has a working default for local development,
# so `docker compose up -d` also works without this file.

# Host user mapping so files written by containers stay owned by you
UID=1000
GID=1000

# Ports exposed on the host
API_PORT=8080
FRONTEND_PORT=5173
DATABASE_PORT=5432
RABBITMQ_UI_PORT=15672

# Backend
APP_ENV=dev
APP_SECRET=change-me-dev-secret
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
# Comma-separated list of active worlds accepted by the API (empty = built-in list)
TIBIA_WORLDS=

# Sentry (backend errors + logs). Project DSN from sentry.io or a self-hosted Sentry; empty = disabled
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
# Optional separate Sentry projects for the bot (Node) and the web app (React); default: SENTRY_DSN
SENTRY_DSN_BOT=
SENTRY_DSN_FRONTEND=

# Database / broker
POSTGRES_DB=warden
POSTGRES_USER=app
POSTGRES_PASSWORD=app
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Shared secret the Discord bot uses to call the API
BOT_API_TOKEN=dev-bot-token-change-me

# Admins: Discord user ids (comma separated) of the accounts that see the Players list.
# The account must be linked to that Discord user (log in with Discord or /link).
ADMIN_DISCORD_IDS=

# Discord bot (leave DISCORD_TOKEN empty to run the bot in dry-run mode: events are logged only)
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# "Log in with Discord" uses DISCORD_APPLICATION_ID as the OAuth2 client id. Copy the Client Secret
# from Developer Portal -> OAuth2, and add <FRONTEND_URL>/auth/discord/callback under Redirects there.
# Leave empty to hide the Discord login button.
DISCORD_CLIENT_SECRET=
# Optional: register slash commands in one guild only (instant) instead of globally
DISCORD_GUILD_ID=
# Public alerts go to the channel named <prefix><world> (e.g. #wardens-monza). Empty prefix = #monza
CHANNEL_PREFIX=wardens-
# Targeted DMs to players who still need the monster; false = post to channels only
DISCORD_DM_ENABLED=false
# Delete alerts when they expire; false = keep them with the [Zabiłem] button disabled
DISCORD_DELETE_EXPIRED=true
# Alerts @mention players missing the Warden; after this many seconds the mentions are edited out
DISCORD_PING_CLEANUP_SECONDS=1
# Roles (comma separated ids) pinged with every alert; a server without the role skips it.
# The role must be mentionable, or the bot needs "Mention @everyone, @here and All Roles".
DISCORD_PING_ROLE_IDS=

# Dev file watching (bot: tsx watch, frontend: Vite). Polling avoids "EMFILE: too many open files"
# on hosts with a low fs.inotify.max_user_instances; set to false to use inotify.
CHOKIDAR_USEPOLLING=true

# Frontend
VITE_API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
